# SUA AÇÃO: crie uma chave em https://console.groq.com/keys.
# Copie este arquivo para .env.local e preencha a linha abaixo.
# Mantenha a chave apenas no servidor; nunca use o prefixo VITE_ para segredos.
GROQ_API_KEY=

# Porta HTTP do servidor API/produção; em desenvolvimento o proxy Vite usa 3001.
PORT=3001
